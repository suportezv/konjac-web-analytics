# Konjac Web Analytics: contrato de variáveis de ambiente.
# ATENÇÃO: este arquivo é só o MODELO. Não coloque valor real aqui.
# Os valores reais vão no painel de environment do Claude Code na web
# (ícone de nuvem acima da caixa de mensagem > Environment variables),
# nunca no repo e nunca no chat.

# --- BigQuery ---
GCP_PROJECT_ID=
BQ_DATASET=
BQ_LOCATION=
# JSON inteiro da chave da service account, em uma linha
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- GA4 (mesma service account do BigQuery) ---
GA4_PROPERTY_ID=

# --- Google Ads (OAuth2; service account simples NÃO serve, ver CLAUDE.md) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- Meta Ads (fallback; o caminho principal é o conector MCP) ---
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# --- Shopify (fallback; o caminho principal é o conector MCP) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
